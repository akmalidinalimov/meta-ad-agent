# Meta Ad Agent — environment template. Copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# --- Meta (Graph API) ---------------------------------------------------------
META_ACCESS_TOKEN=
META_APP_ID=
META_AD_ACCOUNT_ID=act_123456789
META_BUSINESS_ID=
META_API_VERSION=v23.0
# Conversions pixel used when building OFFSITE_CONVERSIONS ad sets.
META_PIXEL_ID=

# --- Deployment & safety ------------------------------------------------------
# Master kill-switch for live Meta writes. Keep "false" until the live-write path
# is trusted; the approval/execute endpoints refuse to mutate Meta while unset/false.
META_LIVE_WRITES_ENABLED=false
# When set, every state-changing (non-GET) request must send a matching X-API-Key
# header. Leave blank for local single-operator dev (auth disabled). Set a long
# random value in any hosted/shared deployment.
AGENT_API_KEY=
# Browsers the funnel/JSONP + CORS layer may talk to. Comma-separated origins.
# Single-process deploys are same-origin, so this only needs your own URL(s).
FUNNEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# In-process monitoring loop (4-hourly rules). "true" enables it; prefer an
# external cron POSTing /api/monitoring/scheduled in production.
MONITORING_SCHEDULER_ENABLED=false
# How often the in-process loop wakes to check (seconds). Ignored unless enabled.
MONITORING_INTERVAL_SECONDS=3600
# Optional: override where the built SPA is served from (defaults to ./dist).
# SPA_DIST_DIR=
# Logging verbosity (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# --- LLM (optional — agents fall back to deterministic templates if unset) ----
# Which reasoning backend the agent layer uses. "openai" (default) keeps the
# original behavior; "anthropic" (or "claude") routes reasoning to Claude.
REASONING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Anthropic / Claude (only used when REASONING_PROVIDER=anthropic|claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Telegram (optional alerts/commands) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_COMMAND_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# --- Bitrix24 CRM (optional) --------------------------------------------------
BITRIX24_WEBHOOK_URL=
BITRIX24_PORTAL_URL=
BITRIX24_USER_ID=
BITRIX24_WEBHOOK_KEY=

# --- ChatPlace bot webhooks ---------------------------------------------------
# Shared secret for /api/chatplace/events and /api/capi/lead. The bot sends it as
# the x-chatplace-secret header. Leave blank to disable the check (dev only).
CHATPLACE_WEBHOOK_SECRET=

# --- Meta Conversions API relay (/api/capi/lead) ------------------------------
# Turns an in-bot phone capture into a Meta-matchable conversion. Requires
# META_PIXEL_ID and META_ACCESS_TOKEN above.
# Event Meta optimises for. CRMLead keeps the existing custom conversion working.
META_CAPI_EVENT_NAME=CRMLead
# The identity we match on is a website identity (fbp/fbc from the landing page),
# so "website" matches best. "chat" is more literal but matches worse.
META_CAPI_ACTION_SOURCE=website
# Fallback landing URL when the stored identity has none.
META_CAPI_SOURCE_URL=https://alikhanova.cloud/
# Set temporarily to watch events land in Events Manager -> Test Events, then clear.
META_CAPI_TEST_EVENT_CODE=
# How long a landing-page identity stays joinable. Meta rejects events older than
# 7 days, so there is no value in keeping more.
CAPI_IDENTITY_TTL_DAYS=7
# Prefixed onto bare 9-digit local numbers before hashing.
CAPI_DEFAULT_COUNTRY_CODE=998

# Per-audience CRM funnel (Part 3/4). Comma-separated Bitrix stage IDs that count as "Paid"
# (e.g. UC_IEO03L for a confirmed-payment lead status, or WON for a deal pipeline). If unset,
# /api/crm/funnel guesses by stage-label keywords; set this once the sales team confirms.
BITRIX_PAID_STATUS_IDS=
# Which Bitrix leads the dashboard's CRM stages + count reflect — matched by lead TITLE
# substring (the order/form name). Default = the AI Creators 5.0 order leads.
BITRIX_LEAD_SOURCE_TITLE=AI Creators 5.0 buyurtmasi
# VSL watch metrics (/api/vsl). YOUTUBE_VSL_VIDEO_ID is required. Views need either a Data
# API key OR OAuth; the 50%-watched (audience-retention) metric needs OAuth (a refresh token
# you generate once for your channel). See docs/VSL_YOUTUBE_TRACKING.md.
YOUTUBE_VSL_VIDEO_ID=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
